{
  "name": "bread-companion-online",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.4.0",
    "vite": "8.3.5",
    "wrangler": "4.154.0",
    "@types/three": "0.187.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
