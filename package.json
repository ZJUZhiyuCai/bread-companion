{
  "name": "bread-companion",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "eval:companion": "node scripts/benchmark-companion.mjs",
    "check:models": "node scripts/inspect-companion-glb.mjs public/companion/3d/bread-phone.glb"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "fake-indexeddb": "^6.2.4",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "description": "Bread: a warm, local-first text and voice companion with a bounded agent harness.",
  "license": "MIT",
  "author": "Zhiyu Cai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZJUZhiyuCai/bread-companion.git"
  },
  "bugs": {
    "url": "https://github.com/ZJUZhiyuCai/bread-companion/issues"
  },
  "homepage": "https://github.com/ZJUZhiyuCai/bread-companion#readme"
}
