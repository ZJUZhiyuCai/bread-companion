# No keys required for the full rule-based text demo.
AGENT_PROVIDER=mock
AGENT_PROTOCOL=anthropic
AGENT_BASE_URL=http://127.0.0.1:3425/v1
AGENT_API_KEY=
AGENT_PROCESSOR_LABEL="配置的 DeepSeek 接入服务"
AGENT_MODEL=wanjie/deepseek-v4.1-flash-1017
# Optional: a separate companion model for listen mode, through the same Magpie endpoint.
# Keep empty to use AGENT_MODEL for all modes. These are server settings, never user onboarding.
AGENT_COMPANION_MODEL=
AGENT_COMPANION_PROTOCOL=anthropic
AGENT_COMPANION_PROCESSOR_LABEL="配置的陪伴模型接入服务"
# Optional phone-only route. Empty inherits the companion route.
AGENT_CALL_MODEL=
AGENT_CALL_PROTOCOL=anthropic
AGENT_CALL_PROCESSOR_LABEL="配置的电话模型接入服务"
AGENT_TIMEOUT_MS=45000
COMPANION_TIMEOUT_MS=15000
MOCK_DELAY_MS=400
ASR_PROVIDER=disabled
TTS_PROVIDER=disabled
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_ASR_MODEL=asr-1.0
MINIMAX_VOICE_ID="Chinese (Mandarin)_Warm_Bestie"
MINIMAX_VOICE_SPEED=1
SPEECH_TIMEOUT_MS=30000

# Hosted Worker only. Leave absent for loopback development.
# Configure these through your hosting secret store, not NEXT_PUBLIC_*.
# BREAD_PUBLIC_ORIGIN=https://your-actual-site.example
# BREAD_VISITOR_SECRET=<at-least-32-random-characters>
# Hosted mode also requires a DB binding with deployment/sites/drizzle migrations.
