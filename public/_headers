# Static assets use the same boundary headers as application routes.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: microphone=(self), camera=(), geolocation=()
  X-Frame-Options: DENY

# Only content-hashed font filenames match; manifests remain revalidatable.
/design/fonts/bread-voice-*
  Content-Type: font/woff2
  Cache-Control: public, max-age=31536000, immutable

# Preserve Vinext's default immutable bundle policy when supplying custom headers.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
